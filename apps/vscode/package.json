{
  "name": "codexia-archaeologist",
  "displayName": "Codexia",
  "description": "Understand why code exists, how it evolved, what depends on it, and what could break if changed.",
  "version": "0.1.1",
  "publisher": "AxrydeStudio",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dikshant1408/Codexia.git"
  },
  "homepage": "https://github.com/Dikshant1408/Codexia#readme",
  "bugs": {
    "url": "https://github.com/Dikshant1408/Codexia/issues"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other",
    "Linters"
  ],
  "keywords": [
    "archaeology",
    "git-blame",
    "blast-radius",
    "static-analysis",
    "code-story"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "codearch.analyzeWorkspace",
        "title": "Codexia: Analyze Workspace",
        "category": "Codexia"
      },
      {
        "command": "codearch.showCodeStory",
        "title": "Codexia: Show Code Story",
        "category": "Codexia"
      },
      {
        "command": "codearch.showBlastRadius",
        "title": "Codexia: Show Blast Radius",
        "category": "Codexia"
      },
      {
        "command": "codearch.investigateChanges",
        "title": "Codexia: Investigate Changes (Who Broke This?)",
        "category": "Codexia"
      },
      {
        "command": "codearch.analyzeRisk",
        "title": "Codexia: Analyze Risk Score",
        "category": "Codexia"
      },
      {
        "command": "codearch.findDeadCode",
        "title": "Codexia: Find Dead Code",
        "category": "Codexia"
      },
      {
        "command": "codearch.findDuplicates",
        "title": "Codexia: Find Duplicates",
        "category": "Codexia"
      },
      {
        "command": "codearch.inspectArchitecture",
        "title": "Codexia: Inspect Architecture",
        "category": "Codexia"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "codearch.contextSubmenu",
          "group": "7_modification"
        }
      ],
      "codearch.contextSubmenu": [
        {
          "command": "codearch.showCodeStory",
          "group": "1_archaeology@1"
        },
        {
          "command": "codearch.showBlastRadius",
          "group": "1_archaeology@2"
        },
        {
          "command": "codearch.investigateChanges",
          "group": "1_archaeology@3"
        },
        {
          "command": "codearch.analyzeRisk",
          "group": "1_archaeology@4"
        }
      ],
      "submenus": [
        {
          "id": "codearch.contextSubmenu",
          "label": "🔎 Codexia Archaeology"
        }
      ]
    },
    "configuration": {
      "title": "Codexia",
      "properties": {
        "codexia.ai.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable optional AI assistance (disabled by default for 100% offline privacy)."
        },
        "codexia.ai.provider": {
          "type": "string",
          "enum": [
            "none",
            "ollama",
            "openai"
          ],
          "default": "none",
          "description": "AI provider backend (local Ollama or OpenAI compatible)."
        },
        "codexia.ai.model": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Model identifier for local Ollama or OpenAI compatible endpoint."
        },
        "codexia.analysis.maxFiles": {
          "type": "number",
          "default": 10000,
          "description": "Maximum number of source files to index per workspace."
        },
        "codexia.ui.theme": {
          "type": "string",
          "enum": [
            "dark",
            "light",
            "auto"
          ],
          "default": "dark",
          "description": "Visual theme for Codexia dashboard and inspection panels."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "npx esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies --out ../../codexia-0.1.1.vsix"
  },
  "dependencies": {
    "@codearch/protocol": "^0.1.0",
    "@codearch/core": "^0.1.0",
    "@codearch/adapter-vscode": "^0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  },
  "author": "Godrikt (AxrydeStudio)",
  "license": "Apache-2.0"
}
