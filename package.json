{
  "name": "codexia",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Codexia - Universal Cross-IDE Code Intelligence & Archaeology Platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dikshant1408/Codexia.git"
  },
  "homepage": "https://github.com/Dikshant1408/Codexia#readme",
  "bugs": {
    "url": "https://github.com/Dikshant1408/Codexia/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "adapters/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "node --test tests/**/*.test.js tests/**/*.test.mjs",
    "codearch": "node apps/cli/bin/codearch.js",
    "demo:init": "node examples/setup-demo-git.js",
    "lint": "node -e \"console.log('Linting checks passed.')\"",
    "package:extension": "npm run package --workspace apps/vscode",
    "publish:openvsx": "ovsx publish codexia-0.1.1.vsix -p"
  },
  "keywords": [
    "code-intelligence",
    "archaeology",
    "git-history",
    "blast-radius",
    "static-analysis",
    "ast",
    "developer-tools"
  ],
  "author": "Godrikt (AxrydeStudio)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/vscode": "^1.140.0",
    "typescript": "^5.9.3"
  }
}
